{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended", "docker:disable"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["io.ktor"],
      "groupName": "ktor",
      "separateMinorPatch": false
    },
    {
      "matchManagers": ["github-actions"],
      "enabled": false
    }
  ]
}
